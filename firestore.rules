rules_version = '2';

// Only administrator-provisioned members can access the shared ERP workspace.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true;
    }

    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // No client may create, change, list, or delete membership records.
    }

    match /meta/owner {
      allow read: if isMember();
    }

    match /meta/settings {
      allow read, write: if isMember();
    }

    match /{collection}/{record} {
      allow read, write: if collection in [
        'clients', 'suppliers', 'marketing', 'rfqs', 'quotations',
        'salesOrders', 'purchaseOrders', 'proformaInvoices', 'payments',
        'deliveries', 'companyDocs', 'investors', 'expenses',
        'financeEntries', 'schedule', 'costSheets', 'counters'
      ] && isMember();
    }
  }
}
