rules_version = '2';

// Only administrator-provisioned members can access the shared ERP workspace.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true;
    }

    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // No client may create, change, list, or delete membership records.
    }

    match /meta/owner {
      allow read: if isMember();
    }

    match /meta/settings {
      allow read, write: if isMember();
    }

    match /{collection}/{record} {
      allow read, write: if collection in [
        'clients', 'suppliers', 'marketing', 'rfqs', 'quotations',
        'salesOrders', 'purchaseOrders', 'proformaInvoices', 'payments',
        'deliveries', 'companyDocs', 'investors', 'expenses',
        'financeEntries', 'schedule', 'costSheets', 'shipments', 'counters'
      ] && isMember();
    }

    // Each member's name and email, so colleagues can pick them as a message recipient.
    match /profiles/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Messages between members: only the sender and the recipient can read one;
    // only the recipient can mark it read, only the sender can create it.
    match /messages/{id} {
      allow read: if isMember()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isMember() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isMember()
        && (
          (resource.data.toUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'archivedByTo']))
          || (resource.data.fromUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedByFrom']))
        );
    }
  }
}
