rules_version = '2';

// Shared ERP attachments are available only to administrator-provisioned members.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.enabled == true;
    }
    match /attachments/{allPaths=**} {
      allow read: if isMember();
      allow write: if isMember() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
